# Environment variables for the application
# Copy this file to .env.local and update with your actual values

# API Configuration
# Option A (recommended local dev): same-origin proxy via Next.js rewrites
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://localhost:8000

# Option B: browser calls FastAPI directly (requires backend CORS)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# API_PROXY_TARGET=

# AWS S3 Configuration (for media). The Content-Security-Policy allows media from this bucket only.
NEXT_PUBLIC_AWS_S3_BUCKET=projectk-media
NEXT_PUBLIC_AWS_REGION=ap-south-1

# Content-Security-Policy extras, read at runtime by the middleware (space separated origins).
# Set when the API's LiveKit URL or the media bucket is not on this site's own host.
# CSP_CONNECT_ORIGINS=wss://livekit.example.com
# CSP_MEDIA_ORIGINS=https://other-bucket.s3.ap-south-1.amazonaws.com

# LiveKit (voice tutor). Must match keys in LiveKit server + agent.
# Local browser always uses ws://localhost:7880 (see src/lib/livekitUrl.js).
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
