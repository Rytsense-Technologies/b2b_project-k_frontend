# Environment variables for the application
# Copy this file to .env.local and update with your actual values

# API Configuration
# Option A (recommended local dev): same-origin proxy via Next.js rewrites
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://localhost:8000

# Option B: browser calls FastAPI directly (requires backend CORS)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# API_PROXY_TARGET=

# Auth — Super Admin login uses POST /api/v1/auth/login unless explicitly set to true
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# Auth Configuration
NEXT_PUBLIC_AUTH_DOMAIN=your-auth-domain.com

# AWS S3 Configuration (for media)
NEXT_PUBLIC_AWS_S3_BUCKET=projectk-media
NEXT_PUBLIC_AWS_REGION=ap-south-1

# Payment Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key

# Other public variables
NEXT_PUBLIC_APP_NAME=Project K
